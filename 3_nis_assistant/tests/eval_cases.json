  {"id": "eyes-compare", "category": "eyes", "prompts": ["What do you see?", "Look again: has anything changed compared with the first image?"], "setup": {"frame": "spots3"}, "expect": {"min_calls": {"look": 2}, "not_calls": ["move_stage"], "reply_mentions_any": ["same", "no change", "unchanged", "not changed", "nothing has changed", "nothing changed", "hasn't changed", "has not changed", "identical"]}},
  {"id": "eyes-ask", "category": "eyes", "prompts": ["How many bright spots do you see?", "Without taking a new image: were the spots you saw all the same size?"], "setup": {"frame": "spots3"}, "expect": {"calls": ["look", "ask_eyes"], "max_calls": {"look": 1}}},
  {"id": "chat-follow-ups", "category": "conversation", "prompts": ["Hello! What can you do for me?", "What can I do with this microscope?", "And what is a Z-stack?"], "expect": {"no_mutations": true}},
  {"id": "skill-is-loaded-and-followed", "category": "skills", "prompt": "Can you check whether this field is good enough to image?", "setup": {"skills": ["---\nname: check-the-field\ndescription: Check that the field of view is usable before imaging: in focus and well exposed.\ntools: focus, look\n---\n1. Focus with the image sweep over 20 um.\n2. Look and ask whether the image is in focus and whether it is saturated or too dim.\n3. Report both answers in one sentence each.\n"], "frame": "good"}, "expect": {"calls": ["load_skill", "focus", "look"], "args": {"load_skill": {"name": "check-the-field"}, "focus": {"method": "image_sweep"}}, "not_calls": ["run_acquisition"]}},
  {"id": "oc-show", "category": "saved-configurations", "prompt": "What exposure is saved in the FITC optical configuration?", "expect": {"args": {"optical_configuration": {"action": "show"}}, "state": {"configurations": ["DAPI", "FITC", "TxRed", "Brightfield"], "saved_exposures": {"DAPI": 100, "FITC": 100, "TxRed": 100, "Brightfield": 100}}, "reply_mentions_any": ["100"], "max_questions": 1}},
  {"id": "oc-edit", "category": "saved-configurations", "prompt": "Save 250 ms as the exposure of the FITC configuration, so it is there next time.", "expect": {"args": {"optical_configuration": {"action": "edit", "exposure_ms": 250}}, "state": {"configurations": ["DAPI", "FITC", "TxRed", "Brightfield"], "saved_exposures": {"DAPI": 100, "FITC": 250, "TxRed": 100, "Brightfield": 100}}, "max_questions": 1}},
  {"id": "oc-copy", "category": "saved-configurations", "prompt": "Make a copy of the DAPI configuration called DAPI fast, with 20 ms exposure.", "expect": {"args": {"optical_configuration": {"action": "copy", "new_name": "DAPI fast"}}, "state": {"configurations": ["DAPI", "FITC", "TxRed", "Brightfield", "DAPI fast"], "saved_exposures": {"DAPI": 100, "FITC": 100, "TxRed": 100, "Brightfield": 100, "DAPI fast": 20}}, "max_questions": 1}},
  {"id": "oc-delete", "category": "saved-configurations", "prompt": "Delete the TxRed optical configuration.", "expect": {"args": {"optical_configuration": {"action": "delete", "name": "TxRed"}}, "state": {"configurations": ["DAPI", "FITC", "Brightfield"], "saved_exposures": {"DAPI": 100, "FITC": 100, "Brightfield": 100}}, "max_questions": 1}},
  {"id": "oc-session-only", "category": "saved-configurations", "prompt": "Set the exposure to 80 ms for now.", "expect": {"args": {"set_microscope": {"exposure_ms": 80}}, "not_calls": ["optical_configuration"], "state": {"configurations": ["DAPI", "FITC", "TxRed", "Brightfield"], "saved_exposures": {"DAPI": 100, "FITC": 100, "TxRed": 100, "Brightfield": 100}}, "max_questions": 1}},
  {"id": "oc-delete-unknown", "category": "saved-configurations", "prompt": "Delete the GFP configuration.", "expect": {"state": {"configurations": ["DAPI", "FITC", "TxRed", "Brightfield"], "saved_exposures": {"DAPI": 100, "FITC": 100, "TxRed": 100, "Brightfield": 100}}, "reply_mentions_any": ["DAPI", "FITC", "TxRed", "Brightfield"], "max_questions": 1}},
  {"id": "oc-copy-taken", "category": "saved-configurations", "prompt": "Copy FITC and call the copy DAPI.", "expect": {"state": {"configurations": ["DAPI", "FITC", "TxRed", "Brightfield"], "saved_exposures": {"DAPI": 100, "FITC": 100, "TxRed": 100, "Brightfield": 100}}, "reply_mentions_any": ["already", "exists", "taken", "in use"], "max_questions": 1}},
