  {"id": "cam-format-missing", "category": "camera", "prompt": "Set the camera to 3x3 binning.", "expect": {"state": {"camera_format": "FMT 1x1 16"}, "reply_mentions_any": ["1x1", "2x2", "4x4", "not", "no "], "max_questions": 1}},
