Python_RunString("import os, glob, runpy; h = os.path.expanduser('~'); c = ['C:/nikon-step0-610/step0_test.py'] + glob.glob(h + '/Desktop/*/step0_test.py') + glob.glob(h + '/Desktop/*/*/step0_test.py') + glob.glob(h + '/OneDrive*/Desktop/*/step0_test.py') + glob.glob(h + '/Downloads/*/step0_test.py'); f = max((p for p in c if os.path.isfile(p) and '6.10' in open(p, encoding='utf-8').readline()), key=os.path.getmtime); os.environ['STEP0_HERE'] = os.path.dirname(f); runpy.run_path(f, run_name='__main__')");
